FROM registry.access.redhat.com/ubi9/ubi-minimal@sha256:08d4c70f1baf6537a0728656cf7942d561e74a35916509d205b6519861266352

RUN microdnf install -y java-17-openjdk-devel && microdnf clean all

WORKDIR /app
COPY --chmod=0644 ["Java Code/HelloWorld.java", "./"]
RUN javac HelloWorld.java

USER 1001:0
CMD ["java", "HelloWorld"]
